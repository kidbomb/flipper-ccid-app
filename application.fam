App(
    appid="ccid_test",
    name="CCID",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ccid_test_app",
    # Explicit, because the default "*.c*" glob also matches the .cpython-*.pyc
    # files pytest leaves in client/__pycache__, which then break the link.
    sources=["*.c"],
    requires=[
        "gui",
    ],
    stack_size=2 * 1024,
    fap_libs=["mbedtls"],
    fap_category="USB",
    fap_version="1.0",
    fap_author="Filipe Rodrigues",
    fap_description="Emulates a USB smart card reader (CCID) with an ISO7816 T=0 card",
    fap_icon="ccid.png",
)
